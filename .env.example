# Copy to .env and fill in. Loaded automatically by
# src/policy_abstraction/__init__.py on import (override=False, so
# shell-exported vars win over file values).

# === REQUIRED ===

# VLM API key. Used by the VLM-based demo analysis path in
# src/policy_abstraction/vlm/ (and open_perception's VLM stages). Set ONE of:
#
#   OPENAI_API_KEY     — OpenAI directly. Get one at
#                        https://platform.openai.com/api-keys
#   OPENROUTER_API_KEY — route VLM calls through OpenRouter
#                        (https://openrouter.ai/api/v1, OpenAI-wire compatible).
#                        Takes precedence when both are set. Pass an OpenRouter
#                        model id via --vlm-model (e.g. "openai/gpt-4o").
#                        Optionally override OPENROUTER_BASE_URL.
OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""

# === USUALLY REQUIRED ON HEADLESS NODES ===

# X11 display for MuJoCo rendering. Set to your host's display.
DISPLAY=":0"

# MuJoCo rendering backend. Default is "glx" (needs X11). On headless boxes
# use "egl" (GPU offscreen, no display required) or "osmesa" (CPU fallback).
# MUJOCO_GL="egl"

# === OPTIONAL ===

# Persistent JAX recompile cache; speeds up policy-server restarts.
# JAX_COMPILATION_CACHE_DIR="${HOME}/.cache/jax_cache"

# Restrict GPU visibility.
# CUDA_VISIBLE_DEVICES="0"

# Logging defaults (sensible if unset).
COLOREDLOGS_LOG_LEVEL="INFO"
COLOREDLOGS_LOG_FORMAT="[%(asctime)s] %(levelname)s [%(name)s.%(funcName)s:%(lineno)d] %(message)s"
COLOREDLOGS_DATE_FORMAT="%Y-%m-%d %H:%M:%S"

# === OVERRIDES (rarely needed; defaults derived from PROJECT_ROOT) ===

# Override the location of the LIBERO-PRO checkout. Defaults to
# <repo-root>/third_party/LIBERO-PRO.
# LIBERO_PRO_PATH=""

# When analyzing legacy HDF5 logs recorded on another machine, set this to
# the absolute path prefix used on that machine so debug scripts can remap
# stored paths to your local repo root. Used only by
# scripts/debug/low-level/test_cotracker_correspondences.py.
# POLICY_ABSTRACTION_LEGACY_PREFIX="/scratch/<otheruser>/policy_abstraction/"
